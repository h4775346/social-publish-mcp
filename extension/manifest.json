{
  "manifest_version": 3,
  "name": "Social Publish MCP",
  "version": "0.2.0",
  "description": "Lets your local social-publish-mcp server upload and schedule videos on YouTube Studio, Meta Business Suite and TikTok Studio in your own Chrome.",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms", "identity", "identity.email"],
  "host_permissions": [
    "https://studio.youtube.com/*",
    "https://www.youtube.com/*",
    "https://business.facebook.com/*",
    "https://www.facebook.com/*",
    "https://www.tiktok.com/*"
  ],
  "background": { "service_worker": "sw.js" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Social Publish MCP",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  }
}
